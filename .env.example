# Copy to `.env` — that is the only file loaded (app/config.py sets
# env_file=".env"). A `.env.local` is NOT read, despite the convention in some
# other tools. Real environment variables take precedence over `.env`, which is
# how containers and the test suite override it.

# Database
POSTGRES_PASSWORD=replace-with-a-strong-database-password
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:replace-with-a-strong-database-password@localhost:5432/cyberguard
REDIS_PASSWORD=replace-with-a-strong-redis-password
REDIS_PORT=6379
REDIS_URL=redis://:replace-with-a-strong-redis-password@localhost:6379/0

# Security
ENCRYPTION_KEY=your-32-byte-secret-key-here-change-me
SECRET_KEY=your-jwt-secret-key-change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
# First administrator. There is no built-in password. Compose will not start
# until BOOTSTRAP_ADMIN_PASSWORD is replaced. That user is created only when
# the database has no account with this username; later restarts do not reset
# the password. Sign in at the WebUI, then change it.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_EMAIL=admin@example.org
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-one-time-password
ENVIRONMENT=production
AUTO_APPROVE=false
RUNNER_TOKEN=replace-with-a-long-random-runner-token

# LLM Providers are configured in the WebUI (Providers page) as a bound
# Provider + Model pair. Do not put empty API keys here — an empty OpenAI
# placeholder used to be selected as a real provider.
LITELLM_CONFIG={"providers": []}

# WebUI
API_PORT=8000
WEBUI_PORT=3000
WEBUI_URL=http://localhost:3000
CORS_ORIGINS=["http://localhost:3000"]

# Master Agent model is bound in Settings together with a Provider.
# Leave unset until a verified Provider+Model pair is saved in the UI.
MASTER_AGENT_TEMPERATURE=0.7

# Sub-Agent Defaults
SUB_AGENT_TIMEOUT=120
SUB_AGENT_MAX_RETRIES=3
# Email Notifications (optional — leave blank to disable)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=cyberguard@yourdomain.com
SMTP_USE_TLS=true
SMTP_ADMIN_EMAIL=admin@yourdomain.com
