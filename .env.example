# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/cyberguard
REDIS_URL=redis://localhost:6379/0

# Security
ENCRYPTION_KEY=your-32-byte-secret-key-here-change-me
SECRET_KEY=your-jwt-secret-key-change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# LLM Providers
LITELLM_CONFIG={"providers": [{"name": "openai", "api_key": "", "base_url": "https://api.openai.com/v1"}]}

# Celery Flower admin UI (opt-in: docker compose --profile monitoring up).
# It exposes task arguments and can revoke tasks, and has no auth of its own,
# so the container refuses to start unless this is set.
FLOWER_BASIC_AUTH=admin:change-me

# WebUI
WEBUI_URL=http://localhost:3000
CORS_ORIGINS=["http://localhost:3000"]

# Master Agent
MASTER_AGENT_MODEL=gpt-4o
MASTER_AGENT_TEMPERATURE=0.7

# Sub-Agent Defaults
SUB_AGENT_TIMEOUT=120
SUB_AGENT_MAX_RETRIES=3
# Email Notifications (optional — leave blank to disable)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=cyberguard@yourdomain.com
SMTP_USE_TLS=true
SMTP_ADMIN_EMAIL=admin@yourdomain.com
