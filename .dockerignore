# Speed up Docker build context for api / celery / tool-runner
.git/
.gitignore
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/
node_modules/
webui/node_modules/
webui/dist/
webui/.env*
tests/
docs/
k8s/
*.md
# .env holds the real secrets and is injected at runtime via env_file — it must
# never enter the build context. .env.local / .env.example follow for the same
# reason (and to keep the context small).
.env
.env.local
.env.example
.dockerignore
Dockerfile*
tool-runner/Dockerfile
webui/Dockerfile
webui/nginx.conf
webui/vite.config.ts
webui/tsconfig*.json
webui/eslint.config.js
webui/public/
